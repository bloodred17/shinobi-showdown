{
  "name": "shinobi-showdown",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "build:wasm": "nx run game-client:build-wasm",
    "dev": "nx run-many -t serve -p game-server web --parallel=2",
    "format": "nx format:write && cargo fmt --all",
    "format:check": "nx format:check && cargo fmt --all -- --check",
    "lint": "nx run-many -t lint",
    "protocol:generate": "nx run game-protocol:generate",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "verify": "nx run-many -t format-check lint test build typecheck"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "packageManager": "npm@12.0.2",
  "devDependencies": {
    "@angular-devkit/core": "22.2.2",
    "@angular-devkit/schematics": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/language-service": "22.2.2",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "22.2.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "~4.1.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "nx": "23.3.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@shinobi-showdown/protocol": "^0.0.0",
    "rxjs": "~7.8.0"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
