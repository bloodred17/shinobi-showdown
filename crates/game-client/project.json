{
  "name": "game-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "crates/game-client/src",
  "implicitDependencies": ["game-domain", "game-protocol"],
  "tags": ["type:app", "scope:client", "language:rust", "platform:wasm"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo build -p shinobi-game-client" }
    },
    "build-wasm": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/wasm"],
      "options": { "command": "bash tools/scripts/build-wasm.sh" }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo check -p shinobi-game-client" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo test -p shinobi-game-client" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo clippy -p shinobi-game-client --all-targets -- -D warnings"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo fmt -p shinobi-game-client -- --check" }
    }
  }
}
