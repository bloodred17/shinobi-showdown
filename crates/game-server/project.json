{
  "name": "game-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "crates/game-server/src",
  "implicitDependencies": ["game-protocol"],
  "tags": ["type:app", "scope:server", "language:rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo build -p shinobi-game-server" }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo check -p shinobi-game-server" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": { "command": "cargo run -p shinobi-game-server" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo test -p shinobi-game-server" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo clippy -p shinobi-game-server --all-targets -- -D warnings"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo fmt -p shinobi-game-server -- --check" }
    }
  }
}
