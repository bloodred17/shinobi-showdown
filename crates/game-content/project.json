{
  "name": "game-content",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "crates/game-content/src",
  "implicitDependencies": ["game-domain"],
  "tags": ["type:content", "scope:shared", "language:rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo build -p shinobi-game-content" }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo check -p shinobi-game-content" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo test -p shinobi-game-content" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo clippy -p shinobi-game-content --all-targets -- -D warnings"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo fmt -p shinobi-game-content -- --check" }
    }
  }
}
